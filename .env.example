# ──────────────────────────────────────────────────────────────────────
# AI Video Automation Studio — environment configuration
# Copy to .env and fill in. NEVER commit .env (gitignored; this .env.example
# is the only tracked env file). Full reference: docs/env-vars.md (which
# process reads each var, when it is required).
# ──────────────────────────────────────────────────────────────────────

# ── Supabase (web + worker) — create your project: docs/supabase-setup.md
# Project URL + keys: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# "anon / public" key — safe for the browser; RLS still enforces everything
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SERVER-ONLY secret (worker / @studio/db). Never expose
# it to the web tier; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── BYOK credential encryption — REQUIRED (openssl rand -base64 32)
# User-supplied provider keys are stored as AES-256-GCM envelopes; only the
# worker decrypts them (per job). The web tier holds this key but uses it
# only to encrypt on save — it can never read stored keys back.
# Rotating invalidates every stored key: users must re-enter them.
CREDENTIAL_ENCRYPTION_KEY=

# ── Scriptwriter provider (worker) — default is the deterministic mock
# Options: mock | anthropic | openai-compatible | nvidia-nim   (unset = mock)
# Used only when a workspace has NO model assignment for the job's task —
# BYOK routing (settings → providers) takes precedence.
# mock = clearly-labeled placeholder scripts (deterministic, free, safe).
# Choosing a real provider without its key set = worker refuses to boot.
SCRIPTWRITER_PROVIDER=mock

# Timeout for a single provider call, ms
PROVIDER_TIMEOUT_MS=120000

# Artificial latency injected into the MOCK provider (ms). Lets you exercise
# cancel-of-a-running-job, worker-kill/reclaim, and heartbeat paths without
# any credentials. 0 (default) = instant.
MOCK_GENERATE_DELAY_MS=0

# ── Anthropic (used when SCRIPTWRITER_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Must be a model currently offered by the Anthropic API (check provider docs
# when you set this; the app has no hardcoded model default).
ANTHROPIC_MODEL=
# Optional: override the Messages API endpoint (proxy/gateway).
ANTHROPIC_BASE_URL=

# ── OpenAI-compatible (used when SCRIPTWRITER_PROVIDER=openai-compatible)
# Works with OpenAI (https://api.openai.com/v1) or any compatible gateway
# such as OpenRouter (https://openrouter.ai/api/v1).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── NVIDIA NIM (used when SCRIPTWRITER_PROVIDER=nvidia-nim, or as BYOK)
# First BYOK provider — users connect their own key in settings → providers.
# These vars are the no-assignment fallback for dev / self-host operation.
NVIDIA_NIM_API_KEY=
# Model id from the live /models catalog (never hard-coded in the app)
NVIDIA_NIM_MODEL=
# Optional: self-hosted NIM container endpoint
NVIDIA_NIM_BASE_URL=

# ── Worker tuning (optional)
# Comments live on their own lines on purpose — inline `#` handling varies
# across env loaders, and a trailing comment can silently become part of
# the value (e.g. WORKER_POLL_MS="2000  # note" → NaN downstream).
# Poll interval while jobs may be pending
WORKER_POLL_MS=2000
# Poll interval after consecutive empty polls
WORKER_IDLE_POLL_MS=15000
# Jobs claimed per poll cycle
WORKER_CLAIM_BATCH=2
# Running + locked_at older than this = reclaimable (seconds)
WORKER_STALE_LOCK_SECONDS=300

# ── Integration tests (npm run test:int) — run against a real Supabase
# project. Silently skipped unless INT=1. Use a disposable/test project.
INT=0
