# ──────────────────────────────────────────────────────────────────────
# AI Video Automation Studio — environment configuration
# Copy to .env and fill in. NEVER commit .env (gitignored; this .env.example
# is the only tracked env file). Full reference: docs/env-vars.md (which
# process reads each var, when it is required).
# ──────────────────────────────────────────────────────────────────────

# ── Supabase (web + worker) — create your project: docs/supabase-setup.md
# Project URL + keys: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# "anon / public" key — safe for the browser; RLS still enforces everything
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SERVER-ONLY secret (worker / @studio/db). Never expose
# it to the web tier; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# ── Scriptwriter provider (worker) — default is the deterministic mock
# Options: mock | anthropic | openai-compatible   (unset = mock)
# mock = clearly-labeled placeholder scripts (deterministic, free, safe).
# Choosing a real provider without its key set = worker refuses to boot.
SCRIPTWRITER_PROVIDER=mock

# Timeout for a single provider call, ms
PROVIDER_TIMEOUT_MS=120000

# Artificial latency injected into the MOCK provider (ms). Lets you exercise
# cancel-of-a-running-job, worker-kill/reclaim, and heartbeat paths without
# any credentials. 0 (default) = instant.
MOCK_GENERATE_DELAY_MS=0

# ── Anthropic (used when SCRIPTWRITER_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Must be a model currently offered by the Anthropic API (check provider docs
# when you set this; the app has no hardcoded model default).
ANTHROPIC_MODEL=

# ── OpenAI-compatible (used when SCRIPTWRITER_PROVIDER=openai-compatible)
# Works with OpenAI (https://api.openai.com/v1) or any compatible gateway
# such as OpenRouter (https://openrouter.ai/api/v1).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── Worker tuning (optional)
WORKER_POLL_MS=2000            # poll interval while jobs may be pending
WORKER_IDLE_POLL_MS=15000      # poll interval after consecutive empty polls
WORKER_CLAIM_BATCH=2          # jobs claimed per poll cycle
WORKER_STALE_LOCK_SECONDS=300 # running + locked_at older than this = reclaimable

# ── Integration tests (npm run test:int) — run against a real Supabase
# project. Silently skipped unless INT=1. Use a disposable/test project.
INT=0
