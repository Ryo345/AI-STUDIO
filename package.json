{
  "name": "ai-video-automation-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Video Automation Studio — turn a topic into a timed script, storyboard, voiceover, captions, and a rendered MP4 across YouTube niches.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
